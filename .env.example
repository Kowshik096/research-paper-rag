HF_HOME=./hf_cache
HF_HUB_CACHE=./hf_cache/hub
SENTENCE_TRANSFORMERS_HOME=./hf_cache

LLM_PROVIDER=gemini
ZEN_API_KEY=your_zen_api_key_here
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=big-pickle

GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBED_FALLBACK_MODELS=gemini-embedding-2
EMBED_DIM=768

RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragdb
OPENSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0

CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=6
CACHE_TTL=86400
API_KEY=your_api_key_here
RATE_LIMIT_RPM=60
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Alternative Zen example (uncomment to use Zen free models):
# ZEN_API_KEY=
# ZEN_BASE_URL=https://opencode.ai/zen/v1
# ZEN_MODEL=deepseek-v4-flash-free
