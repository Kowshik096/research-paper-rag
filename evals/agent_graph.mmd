---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	guardrail(guardrail)
	retrieve(retrieve)
	grade(grade)
	rewrite(rewrite)
	generate(generate)
	refuse(refuse)
	empty(empty)
	__end__([<p>__end__</p>]):::last
	__start__ --> guardrail;
	grade -.-> generate;
	grade -.-> rewrite;
	guardrail -.-> refuse;
	guardrail -.-> retrieve;
	retrieve -.-> empty;
	retrieve -.-> grade;
	rewrite --> retrieve;
	empty --> __end__;
	generate --> __end__;
	refuse --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
